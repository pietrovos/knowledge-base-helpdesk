# Copy to .env to override docker-compose defaults. Nothing here is required to run locally.
# EMBEDDING_PROVIDER=local        # local | voyage | fake
# VOYAGE_API_KEY=
# LLM_PROVIDER=fake               # fake | anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# FAKE_LLM_MODE=ok                # ok | error | timeout | slow  (simulate provider outages)
