# Production image for the API, the Celery worker and one-off jobs (migrations, seed, evals).
#   docker build -f Dockerfile.prod -t supportlens-api .
#   api:      default CMD
#   worker:   celery -A app.worker.celery_app worker --loglevel=INFO
#   migrate:  alembic upgrade head
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /src
# Set EXTRAS="" for a slimmer image that only uses Voyage (or set both for flexibility).
ARG EXTRAS="--extra local-embeddings --extra voyage"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project $EXTRAS
# Bake the default local embedding model into the image so containers never download at boot.
ENV FASTEMBED_CACHE_PATH=/opt/models
RUN if /opt/venv/bin/python -c "import fastembed" 2>/dev/null; then \
      /opt/venv/bin/python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')"; \
    fi

FROM python:3.12-slim
RUN useradd --system --uid 10001 --home /app app
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    FASTEMBED_CACHE_PATH=/opt/models ENV=prod
COPY --from=build /opt/venv /opt/venv
COPY --from=build --chown=app /opt/models /opt/models
WORKDIR /app
COPY --chown=app alembic.ini ./
COPY --chown=app alembic ./alembic
COPY --chown=app app ./app
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
