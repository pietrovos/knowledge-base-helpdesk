      "as_user": "alex",
      "question": "I dropped my headphones and the housing cracked. Will the warranty cover it?",
      "answerable": true,
      "status": "ready",
      "decided_by": "model",
      "correct_decision": true,
      "best_similarity": 0.7686,
      "retrieval_hit": true,
